{
  "manifest_version": 3,
  "name": "Educative to PDF",
  "version": "1.0",
  "description": "Adds a button to download Educative.io lesson pages as PDF documents.",
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://*.educative.io/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.educative.io/*"],
      "js": ["html2pdf.bundle.min.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_title": "Educative PDF Downloader"
  }
}
